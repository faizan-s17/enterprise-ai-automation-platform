# Copy to .env and fill in what you have. Every value below is optional —
# the platform runs fully on local fallbacks with nothing set at all.

ENVIRONMENT=development
# Railway sets DATABASE_URL automatically once a PostgreSQL plugin is added.
# Locally, leave unset to use SQLite (./platform.db).
DATABASE_URL=

# Required in production (ENVIRONMENT=production). The app refuses to start
# with the default key once ENVIRONMENT=production, since that key is public
# in this repo's source. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of origins allowed to call the API. "*" (default) is
# fine for a demo; restrict it to your dashboard's real origin for anything
# beyond that.
CORS_ORIGINS=*

# AI. Leave both unset and every AI feature runs on its deterministic local
# fallback (see app/services/ai.py) instead of a hosted model.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Integration adapters. Leave unset and each one runs in sandbox mode with
# realistic in-memory state instead of calling a real system.
CRM_API_KEY=
CRM_BASE_URL=
ERP_API_KEY=
ERP_BASE_URL=
GOOGLE_WORKSPACE_CREDENTIALS=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=

# n8n. Set this to an n8n webhook URL to have /workflows/trigger actually call
# it; otherwise the run is recorded as simulated.
N8N_WEBHOOK_URL=

# Demo tenant. Used only the first time the database is empty.
SEED_ADMIN_EMAIL=admin@nexgenautomation.com
SEED_ADMIN_PASSWORD=Admin@12345
